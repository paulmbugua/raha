COMPOSE_PROJECT_NAME=secretnairobi
RELEASE_ID=replace-with-git-sha

POSTGRES_DB=secretnairobi
POSTGRES_USER=secretnairobi
POSTGRES_PASSWORD=replace-with-long-random-password
REDIS_PASSWORD=replace-with-long-random-password
MINIO_ROOT_USER=secretnairobi-media
MINIO_ROOT_PASSWORD=replace-with-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes

CLOUDFLARE_TUNNEL_TOKEN=replace-with-dedicated-tunnel-token
